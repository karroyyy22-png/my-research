+        'all_IoUmean': _ph0_mean(IOU_pred_all_np),
+        'all_IoU50': _ph0_mean(IOU_pred_all_np > 0.5),
+        'all_IoU75': _ph0_mean(IOU_pred_all_np > 0.75),
+        'tampered_IoUmean': _ph0_mean(_iou_t),
