     print_freq = 200 
 
     y_true, y_pred, IOU_pred, IOU_50, IOU_75, IOU_95 = [], [], [], [], [], []
+    # ===== [phase0] 拆分统计用的变量 =====
+    import json as _ph0_json
+    _ph0_vf = config['val_file']
